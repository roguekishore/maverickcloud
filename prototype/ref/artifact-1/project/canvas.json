    "t1": { "x": 0, "y": -300, "text": "1 · Page editor", "kind": "title1", "maxW": 3900 },
    "t2": { "x": 0, "y": 1040, "text": "2 · Focus editor: full-screen page, floating toolbar, / and ⌘K", "kind": "title1", "maxW": 3900 },
