{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://selfsite.in/schema/content/1.json",
  "title": "selfsite content document, content model v1 (PROPOSED)",
  "description": "The outer shape only. Section values, theme, shared and business details are checked against the template's fields.json (and the model's fixed business fields) by the field validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "template", "locale", "theme", "business", "shared", "layout", "pages"],
  "properties": {
    "schema": {
      "description": "Content model version. Changes only through a migration.",
      "const": 1
    },
    "template": {
      "description": "<template id>@<template version>",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}@[1-9][0-9]{0,5}$"
    },
    "locale": {
      "description": "The site's language, e.g. en-IN. Translations, when they come, are keyed by stable ids.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "theme": { "type": "object" },
    "business": {
      "description": "Fixed by the model for every site (see validator/business.ts).",
      "type": "object",
      "required": ["name"]
    },
    "shared": {
      "description": "Template-defined values used by several sections.",
      "type": "object"
    },
    "layout": {
      "description": "Sections shown on every page: header(s) before, footer(s) after.",
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/section" } },
        "after": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/section" } }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/definitions/page" }
    }
  },
  "definitions": {
    "id": {
      "description": "Stable id, unique within the document (pages, sections, list items). Never reused, never derived from position.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{2,40}$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "title", "sections"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "path": {
          "type": "string",
          "pattern": "^/([a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*)?$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 70 },
        "description": { "type": "string", "maxLength": 160 },
        "sections": { "type": "array", "maxItems": 40, "items": { "$ref": "#/definitions/section" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "values"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
        "variant": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
        "hidden": { "type": "boolean" },
        "values": { "type": "object" }
      }
    }
  }
}
